[TEMPLATE]
# =====================================================================
# Connectly backend — cloud database credentials
# Copy this file to backend/.env and fill in the values from your
# Aiven (or any external MySQL) service "Connection information" page.
#
#   backend/.env is git-ignored — the password never leaves this machine
#   except to the database provider itself over TLS.
#
# You need 5 values:
# =====================================================================

# 1. Service host, e.g. mysql-xxxx-yyyy.a.aivencloud.com   (NOT "localhost")
DB_HOST=

# 2. Service port, e.g. 12345 (Aiven uses a custom port, not 3306)
DB_PORT=

# 3. Database name (Aiven default is: defaultdb)
DB_NAME=

# 4. Database user (Aiven default is: avnadmin)
DB_USERNAME=

# 5. Database password (the "Admin password" from the service overview)
DB_PASSWORD=

# ---------------------------------------------------------------------
# Optional — you normally don't need to touch these:
# ---------------------------------------------------------------------
# TLS mode for the JDBC connection (REQUIRED is correct for Aiven)
# DB_SSL_MODE=REQUIRED

# Extra JDBC params appended to the URL (rarely needed)
# DB_EXTRA_URL_PARAMS=
